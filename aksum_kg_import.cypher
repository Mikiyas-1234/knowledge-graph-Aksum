CREATE CONSTRAINT node_id IF NOT EXISTS FOR (n:Entity) REQUIRE n.id IS UNIQUE;

CREATE (:Entity:E53_Place {id: 'place_aksum', label: 'Aksum', category: 'archaeological_site', source_document: 'S1;S3;S4', source_locator: 'S1 p.29-32; S4 TOC', epistemic_provenance: 'academic_excavation_report', confidence: 1.0, notes: 'Merges surface variants \'Aksum\'/\'aksum\'/\'Axum\' seen across source files into a single resolved place node (fixes the Aksum/Axum entity-resolution failure identified in the prior code audit).'});
